{
  "name": "brush-words-mini-program",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "build": "node scripts/build.js",
    "lint": "eslint .",
    "test": "node --test test/*.test.js",
    "test:integration": "npm run build && node --test test/integration/*.test.js",
    "test:e2e": "npm run build && node --test test/e2e/*.test.mjs",
    "check": "npm run lint && npm run build && npm test && npm run test:integration"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@weapp-vite/miniprogram-automator": "1.3.0",
    "eslint": "10.5.0"
  },
  "engines": {
    "node": "^22.13.0 || >=24"
  }
}
